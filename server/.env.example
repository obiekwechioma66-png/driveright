# Required API settings
DATABASE_URL="file:./prisma/dev.db" # Local SQLite. Production database must match prisma/schema.prisma provider.
JWT_SECRET=replace_with_a_long_random_secret
PORT=4000 # Usually provided by the hosting platform
CORS_ORIGINS=http://localhost:5173 # Comma-separated exact frontend origins in production

# Paystack test mode; replace with live keys only when ready for real payments.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
PAYSTACK_ALLOW_SIMULATE=0

# Resend reminders. Use a verified sender domain in production.
RESEND_API_KEY=re_replace_with_your_api_key
RESEND_FROM_EMAIL="DriveRight Reminders <reminders@your-verified-domain.ng>"
